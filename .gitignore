# =========================================================================
# .gitignore · Repositorio Técnico ADSO Virtual (SENA CADPH Garzón)
# =========================================================================

# Sistema Operativo (Windows & macOS)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Editores e IDEs
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak
*.orig

# Archivos Temporales y Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Archivos de Entorno y Credenciales
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Dependencias (si se usan herramientas Node.js locales)
node_modules/
dist/
build/
.cache/

# Archivos Temporales de Asistentes AI y Notas Locales
# (Garantiza que no se suban borradores o planes no institucionales)
scratchpad*.md
*walkthrough*.md
*plan*.md
*todo*.md
*notes*.md
temp_*.md
.gemini/
.agents/
.system_generated/
scratch/
temp/
tmp/
*.tmp
